{
  "name": "@nexora/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "start": "tsx src/index.ts",
    "db:create": "tsx src/db/cli.ts create",
    "db:migrate": "tsx src/db/cli.ts migrate",
    "db:reset": "tsx src/db/cli.ts reset",
    "seed": "tsx src/db/cli.ts seed",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "loadtest": "tsx scripts/loadtest.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/cors": "^11.0.0",
    "@fastify/jwt": "^10.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@nexora/shared": "*",
    "fastify": "^5.6.0",
    "pg": "^8.16.0",
    "socket.io": "^4.8.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/pg": "^8.15.0",
    "pino-pretty": "^13.0.0",
    "socket.io-client": "^4.8.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
